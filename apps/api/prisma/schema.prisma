generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @default(uuid())
  email                 String                  @unique
  name                  String
  avatarUrl             String?
  avatarType            String?
  avatarPresetId        String?
  avatarFileKey         String?
  passwordHash          String?
  emailVerifiedAt       DateTime?
  status                String                  @default("active")
  timezone              String                  @default("UTC")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  accounts              Account[]
  sessions              Session[]
  authTokens            AuthToken[]
  ownedGoals            Goal[]                  @relation("GoalOwner")
  completedDailyGoals   GoalDailyOccurrence[]   @relation("DailyOccurrenceCompletedBy")
  goalMemberships       GoalMember[]
  ownedTeams            Team[]                  @relation("TeamOwner")
  teamMemberships       TeamMember[]
  assignedGoalSteps     GoalStep[]              @relation("GoalStepAssignee")
  progresses            GoalStepProgress[]
  dailyStepProgresses   GoalDailyStepProgress[]
  createdInvites        InviteLink[]            @relation("InviteCreator")
  redemptions           InviteRedemption[]
  completedGoals        Goal[]                  @relation("GoalCompletedBy")
  subscriptions         Subscription[]
  goalAuditEvents       GoalAuditEvent[]
  createdReminders      Reminder[]              @relation("ReminderCreator")
  targetedReminders     Reminder[]              @relation("ReminderTarget")
  activityEvents        ActivityEvent[]         @relation("ActivityActor")
  targetActivityEvents  ActivityEvent[]         @relation("ActivityTarget")
  comments              Comment[]               @relation("CommentAuthor")
  reactions             Reaction[]
  goalTemplates         GoalTemplate[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  onboardingCompletedAt DateTime?
  preferencesJson       String                  @default("{}")
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthToken {
  id         String    @id @default(uuid())
  userId     String
  type       String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, tokenHash])
  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id        String         @id @default(uuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  goals     Goal[]
  templates GoalTemplate[]
}

model Goal {
  id                       String                @id @default(uuid())
  ownerUserId              String
  teamId                   String?
  name                     String
  description              String?
  categoryId               String?
  customCategory           String?
  tagsJson                 String                @default("[]")
  startDate                DateTime
  endDate                  DateTime?
  status                   String                @default("active")
  recurrenceType           String                @default("NONE")
  recurrenceTimezone       String?
  completedAt              DateTime?
  completionMode           String?
  completedByUserId        String?
  completionOverrideReason String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  owner                    User                  @relation("GoalOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  team                     Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  category                 Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  completedBy              User?                 @relation("GoalCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  members                  GoalMember[]
  steps                    GoalStep[]
  inviteLinks              InviteLink[]
  auditEvents              GoalAuditEvent[]
  reminders                Reminder[]
  dailyOccurrences         GoalDailyOccurrence[]
  activityEvents           ActivityEvent[]
  comments                 Comment[]

  @@index([ownerUserId])
  @@index([teamId])
  @@index([categoryId])
  @@index([status])
}

model GoalMember {
  id        String   @id @default(uuid())
  goalId    String
  userId    String
  role      String
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, userId])
  @@index([userId])
}

model GoalStep {
  id              String                  @id @default(uuid())
  goalId          String
  title           String
  description     String?
  position        Int
  assignmentMode  String                  @default("ALL_PARTICIPANTS")
  assigneeUserId  String?
  assigneeName    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  goal            Goal                    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  assigneeUser    User?                   @relation("GoalStepAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  progresses      GoalStepProgress[]
  dailyProgresses GoalDailyStepProgress[]
  reminders       Reminder[]

  @@unique([goalId, position])
  @@index([goalId])
  @@index([assigneeUserId])
}

model GoalStepProgress {
  id          String    @id @default(uuid())
  goalStepId  String
  userId      String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  goalStep    GoalStep  @relation(fields: [goalStepId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalStepId, userId])
  @@index([userId])
}

model GoalDailyOccurrence {
  id                       String                  @id @default(uuid())
  goalId                   String
  localDate                String
  completedAt              DateTime?
  completionMode           String?
  completedByUserId        String?
  completionOverrideReason String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  goal                     Goal                    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  completedBy              User?                   @relation("DailyOccurrenceCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  stepProgresses           GoalDailyStepProgress[]

  @@unique([goalId, localDate])
  @@index([goalId, localDate])
  @@index([completedByUserId])
}

model GoalDailyStepProgress {
  id           String              @id @default(uuid())
  occurrenceId String
  goalStepId   String
  userId       String
  completed    Boolean             @default(false)
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  occurrence   GoalDailyOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  goalStep     GoalStep            @relation(fields: [goalStepId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, goalStepId, userId])
  @@index([goalStepId])
  @@index([userId])
}

model Team {
  id             String          @id @default(uuid())
  ownerUserId    String
  name           String
  description    String?
  avatarUrl      String?
  imageFileKey   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  owner          User            @relation("TeamOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  goals          Goal[]
  activityEvents ActivityEvent[]
  inviteLinks    InviteLink[]

  @@index([ownerUserId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      String
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model InviteLink {
  id              String             @id @default(uuid())
  tokenHash       String             @unique
  targetType      String
  teamId          String?
  goalId          String?
  role            String
  createdByUserId String
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  team            Team?              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  goal            Goal?              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  createdBy       User               @relation("InviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  redemptions     InviteRedemption[]

  @@index([teamId])
  @@index([goalId])
  @@index([expiresAt])
}

model InviteRedemption {
  id           String     @id @default(uuid())
  inviteLinkId String
  userId       String
  acceptedAt   DateTime   @default(now())
  inviteLink   InviteLink @relation(fields: [inviteLinkId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteLinkId, userId])
  @@index([userId])
}

model Plan {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  limitsJson    String         @default("{}")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id                     String    @id @default(uuid())
  userId                 String
  planId                 String
  status                 String
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  provider               String?
  providerSubscriptionId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([planId])
}

model GoalAuditEvent {
  id          String   @id @default(uuid())
  goalId      String
  actorUserId String
  eventType   String
  reason      String?
  createdAt   DateTime @default(now())
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([actorUserId])
}

model Reminder {
  id              String         @id @default(uuid())
  creatorUserId   String
  targetUserId    String
  goalId          String
  goalStepId      String?
  remindAt        DateTime
  timezone        String
  status          String         @default("pending")
  deliveredAt     DateTime?
  recurrenceType  String         @default("ONCE")
  timeOfDay       String?
  lastDeliveredAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  creator         User           @relation("ReminderCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  target          User           @relation("ReminderTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  goal            Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalStep        GoalStep?      @relation(fields: [goalStepId], references: [id], onDelete: SetNull)
  notifications   Notification[]

  @@index([creatorUserId, status, remindAt])
  @@index([targetUserId, status, remindAt])
  @@index([goalId])
  @@index([goalStepId])
}

model ActivityEvent {
  id           String   @id @default(uuid())
  actorUserId  String
  eventType    String
  goalId       String?
  teamId       String?
  targetUserId String?
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
  actor        User     @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  targetUser   User?    @relation("ActivityTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  goal         Goal?    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  team         Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
  @@index([teamId, createdAt])
  @@index([actorUserId, createdAt])
}

model Comment {
  id           String     @id @default(uuid())
  goalId       String
  authorUserId String
  body         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  goal         Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  author       User       @relation("CommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  reactions    Reaction[]

  @@index([goalId, createdAt])
  @@index([authorUserId])
}

model Reaction {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([userId])
}

model GoalTemplate {
  id             String    @id @default(uuid())
  ownerUserId    String?
  name           String
  description    String?
  categoryId     String?
  customCategory String?
  tagsJson       String    @default("[]")
  stepsJson      String    @default("[]")
  isOfficial     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  owner          User?     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([categoryId])
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  type        String
  title       String
  body        String
  goalId      String?
  teamId      String?
  reminderId  String?
  deliveryKey String?   @unique
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder    Reminder? @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([goalId])
  @@index([teamId])
}

model PushSubscription {
  id        String    @id @default(uuid())
  userId    String
  endpoint  String    @unique
  p256dh    String
  auth      String
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}
